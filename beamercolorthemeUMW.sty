\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamercolorthemeUMW}[2026/10/10 Motyw kolorystyczny UMW]

\RequirePackage{xcolor}

\definecolor{UMWGold}{HTML}{D0A53E}
\definecolor{UMWNavy}{HTML}{2B2B5C}
\definecolor{UMWBlack}{HTML}{000000}
\definecolor{UMWGray}{HTML}{F4F4F4}

\setbeamercolor{palette primary}{bg=UMWNavy, fg=white}
\setbeamercolor{palette secondary}{bg=UMWGold, fg=black}
\setbeamercolor{palette tertiary}{bg=UMWBlack, fg=white}

\setbeamercolor{titlelike}{parent=palette primary}
\setbeamercolor{frametitle}{bg=UMWNavy, fg=UMWGold}
\setbeamercolor{structure}{fg=UMWNavy}

\setbeamercolor{block title}{bg=UMWNavy, fg=white}
\setbeamercolor{block body}{bg=UMWGray, fg=black}

\setbeamercolor{block title alerted}{bg=UMWGold, fg=black}
\setbeamercolor{block body alerted}{bg=UMWGray, fg=black}

\setbeamercolor{block title example}{bg=UMWBlack, fg=white}
\setbeamercolor{block body example}{bg=UMWGray, fg=black}
